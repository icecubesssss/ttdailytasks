{
  "name": "tt-daily-task",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "pack": "repomix",
    "migrate:assignee": "node scripts/migrate-assignee.mjs",
    "migrate:assignee:dry": "node scripts/migrate-assignee-admin.mjs",
    "migrate:assignee:apply": "node scripts/migrate-assignee-admin.mjs --apply",
    "deploy:widget-infra": "firebase deploy --only firestore:rules",
    "deploy:web": "npm run build && firebase deploy --only hosting",
    "start:desktop": "NODE_ENV=development electron .",
    "start:prod": "electron .",
    "release": "node scripts/release.mjs",
    "make:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.108.1",
    "canvas-confetti": "^1.9.4",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.11.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "pg": "^8.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vaul": "^1.1.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.4.2",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^13.8.0",
    "globals": "^17.4.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.8",
    "repomix": "^1.13.1",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.1"
  },
  "build": {
    "appId": "com.ttdailytask.app",
    "productName": "TT Daily Task",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    }
  }
}
